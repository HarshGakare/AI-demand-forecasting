# Virtual environments
.venv/
venv/
env/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/

# Environment secrets
.env
.env.*
!.env.example

# Data files: never publish datasets by default
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Model artifacts
models/*
*.pkl
*.joblib
*.h5
*.keras
*.pt
*.pth

# Generated reports: allow selected reports to be committed
reports/*
!reports/README.md
!reports/*.csv
!reports/*.png
!reports/*.jpg
!reports/*.svg

# Logs and temporary files
*.log
*.tmp
*.bak

# IDE settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Local databases and exports
*.sqlite
*.sqlite3
*.db
# Generated reports: ignore everything by default
reports/*

# Allow selected portfolio summaries
!reports/README.md
!reports/baseline_metrics.csv
!reports/champion_model_evaluation.csv
!reports/champion_model_summary.csv
!reports/data_quality_report.csv
!reports/ensemble_final_metrics.csv
!reports/experiment_tracking_report.csv
!reports/inventory_optimization.csv
!reports/lightgbm_metrics.csv
!reports/model_comparison_cv_summary.csv
!reports/model_selection_cv_summary.csv
!reports/multi_horizon_metrics.csv
!reports/multi_horizon_predictions.csv
!reports/recursive_forecast_metrics.csv
!reports/rolling_cv_summary.csv
!reports/shap_feature_importance.csv
